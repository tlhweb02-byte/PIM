# ============================================
# 宝尊扩图账号敏感配置模板
# 使用方法：
#   1. 复制本文件并重命名为 .env
#   2. 填入你自己的真实账号信息（.env 已被 .gitignore 忽略，不会上传到 GitHub）
# ============================================

# 宝尊平台登录账号
BAOZUN_USERNAME=

# 宝尊平台登录密码
BAOZUN_PASSWORD=

# 用于接收宝尊验证码的 QQ 邮箱（公司邮箱需设置自动转发到此 QQ 邮箱）
BAOZUN_QQ_EMAIL=

# QQ 邮箱 IMAP/SMTP 授权码（QQ 邮箱设置 -> 账户 -> 开启 IMAP/SMTP 服务 获取）
BAOZUN_QQ_AUTH_CODE=

# QQ 邮箱 IMAP 服务器（一般无需修改）
BAOZUN_IMAP_SERVER=imap.qq.com

# 登录后选择的租户（登录接口会返回可选租户列表，如 baozun 宝尊 / NIKE 耐克）
BAOZUN_TENANT=baozun

# 应用标识（ROSS 前端固定值，一般无需修改）
BAOZUN_APPKEY=ross-modern-api

# ============================================
# 用户注册 / 宝尊扩图试用次数配置（可选）
# ============================================

# 管理员用户名（多个用英文逗号分隔）：
# 这些账号使用宝尊扩图【不受 10 次限制】。请先自己注册一个账号，
# 再把该用户名填到这里（Streamlit Cloud 请在 Secrets 中配置）。
# 示例：AUTH_ADMIN_USERNAMES=your_admin_name
AUTH_ADMIN_USERNAMES=

# 新用户免费体验次数（默认 10 次，可修改）
AUTH_FREE_QUOTA=10

# ============================================
# 次数充值（微信个人收款码）
# ============================================

# 微信收款码解码内容（个人收款码 wxp://...）：
# 用户扫码付款后提交微信交易单号，管理员核实到账后确认，次数自动到账
WECHAT_PAY_CODE=wxp://f2f0NgLTfBBVcEM-SaA4TyKFmxDk6QUo5LTFM4zS_X11HEs

# 套餐定价：每份次数 / 每份价格（元）
WECHAT_PAY_QUOTA=100
WECHAT_PAY_PRICE=10
