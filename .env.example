# ============================================
# 宝尊扩图账号敏感配置模板
# 使用方法：
#   1. 复制本文件并重命名为 .env
#   2. 填入你自己的真实账号信息（.env 已被 .gitignore 忽略，不会上传到 GitHub）
# ============================================

# 宝尊平台登录账号
BAOZUN_USERNAME=

# 宝尊平台登录密码
BAOZUN_PASSWORD=

# 用于接收宝尊验证码的 QQ 邮箱
BAOZUN_QQ_EMAIL=

# QQ 邮箱 IMAP/SMTP 授权码（QQ 邮箱设置 -> 账户 -> 开启 IMAP/SMTP 服务 获取）
BAOZUN_QQ_AUTH_CODE=

# QQ 邮箱 IMAP 服务器（一般无需修改）
BAOZUN_IMAP_SERVER=imap.qq.com
